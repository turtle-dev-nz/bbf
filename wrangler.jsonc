// Cloudflare Worker that serves the STAGING site (static assets only, no server code).
// Deployed by .github/workflows/deploy-staging.yml - never by Cloudflare's Git integration.
// Production is NOT on Cloudflare; it goes to cPanel via deploy-cpanel.yml.
{
  "name": "bbf-staging",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. /sams-big-brain-run on a hard refresh) serve index.html
    // so React Router can handle them.
    "not_found_handling": "single-page-application",
  },

  // Serve only on the custom domain. The workers.dev and preview URLs stay off,
  // so there's no second, unprotected address for staging.
  "routes": [{ "pattern": "bbf.owennicholson.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
