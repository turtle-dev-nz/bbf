# Copy to .env.local and fill in. All optional: src/events/sams-big-brain-run/config.ts has defaults.

# Donation webhook Apps Script (GET returns total, supporter count and recent messages)
VITE_CAMPAIGN_STATS_URL=

# Contact-form Apps Script (scripts/contactForm.js). Leave empty to fall back to mailto.
VITE_CONTACT_FORM_URL=

# Read-only live-run data proxy for the hidden dashboard. Leave empty to use mock data.
VITE_LIVE_DATA_URL=

# Raisely iframe embed URL
VITE_RAISELY_EMBED_URL=
